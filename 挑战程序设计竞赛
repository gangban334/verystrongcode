#include <iostream>
#include <algorithm>
#include <vector>
#include <queue>
using namespace std;
struct io{
  int id;
  int begin;
  int end;
  bool operator <(const io& p)const{
    return begin<p.begin;
  }
};
struct fence{
  int id;
  int end;
  int door;
  bool operator < (const fence& p)const{
    return end>p.end;
  }
};
int main(){
    int n;
    cin>>n;
    vector<io> cow;
    priority_queue<fence> dui;    
    for(int i=0;i<n;i++){
      int begin,end;
      cin>>begin>>end;
      cow.push_back({i,begin,end});
    }
    sort(cow.begin(),cow.end());
    int cnt=1;
    dui.push({cow[0].id,cow[0].end,cnt});
    int a[50002];
    for(int i=1;i<n;i++){
      if(cow[i].begin>dui.top().end){
        dui.push({cow[i].id,cow[i].end,dui.top().door});
        a[dui.top().id]=dui.top().door;
        dui.pop();
      }else dui.push({cow[i].id,cow[i].end,++cnt});
    }
    while(dui.size()){
        a[dui.top().id]=dui.top().door;
        dui.pop();
    }
    cout<<cnt<<endl;
    for(int i=0;i<n;i++){
      cout<<a[i]<<endl;
    }
    return 0;
  }
